<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Rag.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Talks to Ollama; also brings Microsoft.Extensions.AI.Abstractions (IChatClient, IEmbeddingGenerator) -->
    <PackageReference Include="OllamaSharp" Version="5.5.2" />
    <!-- EF Core provider for PostgreSQL -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <!-- pgvector support for EF Core: the Vector type and CosineDistance() -->
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <!-- Document readers (the .NET replacement for Docling).
         NOTE: the book says "UglyToad.PdfPig", but the official NuGet package id is "PdfPig"
         (its namespace is UglyToad.PdfPig). -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
  </ItemGroup>

</Project>
